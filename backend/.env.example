# Copie este arquivo para ".env" (na mesma pasta) e preencha com os
# valores reais do seu ambiente. O ".env" nunca deve ser commitado
# (ja esta no .gitignore).

# ==========================================================
# CLP Siemens S7-1500 (comunicacao via python-snap7)
# ==========================================================
# IP do CLP na rede local. Obrigatorio, sem valor padrao no codigo.
PLC_IP=192.168.0.100
# Rack e slot do CLP na configuracao do TIA Portal.
PLC_RACK=0
PLC_SLOT=1

# ==========================================================
# Banco de dados MySQL / MariaDB
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siemens_plc_monitor

# ==========================================================
# Loop de monitoramento automatico (backend/automacao.py)
# ==========================================================
# Liga/desliga a leitura automatica em background ao subir a API.
LEITURA_AUTOMATICA_ATIVA=true
# Intervalo (segundos) entre snapshots salvos em leituras_producao.
# Recomendado manter >= 10s para nao gerar volume excessivo de linhas.
LEITURA_INTERVALO_SEGUNDOS=10
# Intervalo (segundos) entre verificacoes de estado (parada/alarme).
MONITORAMENTO_INTERVALO_SEGUNDOS=2
